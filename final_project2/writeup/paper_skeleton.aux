\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Phase 2A test metrics on the leaky pipeline. Behavior-anchored algorithms (BC, AWAC, CQL, IQL) collapse to the equal-weight basin (Sharpe $\approx 0.94$, turnover $\le 0.005$) under friction; pure $Q$-maximizing algorithms with weak anchoring (TD3+BC, BCQ) escape the basin and produce implausibly high Sharpe by exploiting the in-observation reward signal. Equal-weight reference: Sharpe $0.953$. Mean $\pm $ std across 3 seeds.}}{18}{table.caption.58}\protected@file@percent }
\newlabel{tab:leak-differential}{{5}{18}{Phase 2A test metrics on the leaky pipeline. Behavior-anchored algorithms (BC, AWAC, CQL, IQL) collapse to the equal-weight basin (Sharpe $\approx 0.94$, turnover $\le 0.005$) under friction; pure $Q$-maximizing algorithms with weak anchoring (TD3+BC, BCQ) escape the basin and produce implausibly high Sharpe by exploiting the in-observation reward signal. Equal-weight reference: Sharpe $0.953$. Mean $\pm $ std across 3 seeds}{table.caption.58}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Phase 2A causal sanity check, n=3 seeds per row. The four behavior-anchored algorithms cluster tightly at Sharpe $\approx 0.94$ on the causal pipeline, mirroring the leaky-pipeline behavior. Every cell lands inside the pre-registered $[0.85,\,1.05]$ leak-invariance band. Equal-weight reference: Sharpe $0.953$.}}{18}{table.caption.59}\protected@file@percent }
\newlabel{tab:causal-confirmation}{{6}{18}{Phase 2A causal sanity check, n=3 seeds per row. The four behavior-anchored algorithms cluster tightly at Sharpe $\approx 0.94$ on the causal pipeline, mirroring the leaky-pipeline behavior. Every cell lands inside the pre-registered $[0.85,\,1.05]$ leak-invariance band. Equal-weight reference: Sharpe $0.953$}{table.caption.59}{}}
