\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Empirical CDF of test-window Sharpe ratios for $N{=}10{,}000$ random Dirichlet$(1)$ static allocations on the 1{,}061-day test window, evaluated under Eq.~\ref {eq:reward} at $\lambda {=}0.001$. Vertical guides mark the named classical anchors (equal-weight at the 59.56th percentile, rolling risk-parity at the 81.41st, GLD-100 at the 88.27th, training-window min-variance at the 94.65th) and the adaptive O2O mean at the 99.49th. Shaded bands give the seed-to-seed range of naive O2O (effectively the full simplex distribution) and adaptive O2O (clustered in the top $\sim 1.25\%$).}}{9}{figure.caption.29}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:static-sharpe-cdf}{{1}{9}{Empirical CDF of test-window Sharpe ratios for $N{=}10{,}000$ random Dirichlet$(1)$ static allocations on the 1{,}061-day test window, evaluated under Eq.~\ref {eq:reward} at $\lambda {=}0.001$. Vertical guides mark the named classical anchors (equal-weight at the 59.56th percentile, rolling risk-parity at the 81.41st, GLD-100 at the 88.27th, training-window min-variance at the 94.65th) and the adaptive O2O mean at the 99.49th. Shaded bands give the seed-to-seed range of naive O2O (effectively the full simplex distribution) and adaptive O2O (clustered in the top $\sim 1.25\%$)}{figure.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Phase 2C naive O2O. Three seeds, $\lambda {=}0.001$. Turnover is functionally zero (max $6.5\!\times \!10^{-6}$); Sharpe varies wildly because each seed locks into a different static allocation from the CQL pretrain. The \%ile column is the empirical percentile rank of each seed's test Sharpe against the $N{=}10{,}000$ random Dirichlet$(1)$ static-allocation reference distribution (Fig.~\ref {fig:static-sharpe-cdf}); the per-seed range covers essentially the full simplex.}}{9}{table.caption.31}\protected@file@percent }
\newlabel{tab:naive-o2o}{{1}{9}{Phase 2C naive O2O. Three seeds, $\lambda {=}0.001$. Turnover is functionally zero (max $6.5\!\times \!10^{-6}$); Sharpe varies wildly because each seed locks into a different static allocation from the CQL pretrain. The \%ile column is the empirical percentile rank of each seed's test Sharpe against the $N{=}10{,}000$ random Dirichlet$(1)$ static-allocation reference distribution (Fig.~\ref {fig:static-sharpe-cdf}); the per-seed range covers essentially the full simplex}{table.caption.31}{}}
\@writefile{toc}{\contentsline {paragraph}{Adaptive O2O: seed-stable selection of the static basin (final, n=3).}{9}{section*.32}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Phase 2C adaptive O2O. Three seeds, $\lambda {=}0.001$. Sharpe is tightly clustered above $+1.6$, in contrast to naive O2O's $[-0.24, +2.18]$ range (Table~\ref {tab:naive-o2o}); turnover remains functionally static. The \%ile column is the empirical percentile rank of each seed's test Sharpe against the $N{=}10{,}000$ random Dirichlet$(1)$ static-allocation reference distribution (Fig.~\ref {fig:static-sharpe-cdf}); all three seeds land in the $[98.74, 99.93]$ band, and the seed-mean Sharpe sits at the $99.49$th percentile.}}{10}{table.caption.33}\protected@file@percent }
\newlabel{tab:adaptive-o2o}{{2}{10}{Phase 2C adaptive O2O. Three seeds, $\lambda {=}0.001$. Sharpe is tightly clustered above $+1.6$, in contrast to naive O2O's $[-0.24, +2.18]$ range (Table~\ref {tab:naive-o2o}); turnover remains functionally static. The \%ile column is the empirical percentile rank of each seed's test Sharpe against the $N{=}10{,}000$ random Dirichlet$(1)$ static-allocation reference distribution (Fig.~\ref {fig:static-sharpe-cdf}); all three seeds land in the $[98.74, 99.93]$ band, and the seed-mean Sharpe sits at the $99.49$th percentile}{table.caption.33}{}}
