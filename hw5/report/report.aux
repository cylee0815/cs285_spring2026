\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces FQL training diagnostics on \texttt  {cube-single} with best $\alpha $ (300). \emph  {Top-left}: BC actor flow loss decreases as the vector field learns the diffusion path from noise to dataset actions. \emph  {Top-middle}: One-step actor distillation (purple) and Q-maximization (red) losses; the Q-max loss dominates early and decreases as the actor learns to exploit the critic. \emph  {Top-right}: MSE between one-step actor and BC actor decreases, confirming successful distillation. \emph  {Bottom-left/middle}: Q loss and Q values converge. \emph  {Bottom-right}: Evaluation success rate.\relax }}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:q3_diag}{{6}{7}{FQL training diagnostics on \texttt {cube-single} with best $\alpha $ (300). \emph {Top-left}: BC actor flow loss decreases as the vector field learns the diffusion path from noise to dataset actions. \emph {Top-middle}: One-step actor distillation (purple) and Q-maximization (red) losses; the Q-max loss dominates early and decreases as the actor learns to exploit the critic. \emph {Top-right}: MSE between one-step actor and BC actor decreases, confirming successful distillation. \emph {Bottom-left/middle}: Q loss and Q values converge. \emph {Bottom-right}: Evaluation success rate.\relax }{figure.caption.13}{}}
